# cp terraform.tfvars.example terraform.tfvars して値を埋める。
# terraform.tfvars は gitignore 対象（プロジェクト ID 等の実値を置く）。
environment  = "prod"
project_id   = "your-project-prod"
cors_origins = "https://your-app.example.com"
# deployer_service_account_email = "deployer@your-project-prod.iam.gserviceaccount.com"
